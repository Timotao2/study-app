# Copy to .env (never commit .env). Generate the key with:  python manage.py secret
SECRET_KEY=replace-me
RP_ID=studybuddy.foo
ORIGIN=https://studybuddy.foo

# Lockout alert emails (optional). For Gmail: enable 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
ALERT_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=16-character-app-password

# Edge policy. Cloudflare tags each request with the visitor's country (CF-IPCountry);
# these are refused with 403 before anything else runs. Empty = allow everyone.
BLOCK_COUNTRIES=CN,RU,IN
# 1 = also refuse requests that bypass Cloudflare and hit the PythonAnywhere hostname directly.
REQUIRE_CLOUDFLARE=0
